---
import '../index.css';
import { resolveAsset } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "mei.munchii — Artist Portfolio",
  description = "Showcase of art by mei.munchii featuring manga, silent one-shots, and 2-D illustration."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f0ea" />
    <link rel="icon" type="image/svg+xml" href={resolveAsset("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Italiana&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
